# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
MAISON_PASSWORD=change-moi-12-caracteres-minimum
# Jeton commun des échanges entre applis maison : demandes à carnet (carnet ≥ 2.25.0), annuaire de l'Anneau
# (adresse donnée aux invités) et sauvegarde des réglages par l'Anneau. Vide : carnet n'est pas lu, pas de QR code.
# MAISON_JETON=un-long-jeton-commun
# Clé de lecture de l'Anneau (contrat 3) : n'ouvre que les fiches « Connexion ». Vide : l'Anneau ne les lit pas.
# ANNEAU_CLE=une-autre-longue-cle

# Dossier du NAS pour la base, les réglages et les sauvegardes
DOUZE_POINTS_DATA_DIR=/chemin/du/nas/douze-points

# Facultatif
# PORT_DOUZE_POINTS=8088

# Depuis la 1.2, plus rien d'autre dans la stack :
# - l'adresse donnée aux invités vient de la tuile « Douze points » de l'Anneau (adresse locale) ;
# - le webhook de Home Assistant se règle dans l'écran Réglages (repris une fois de l'ancienne variable).
