# Variables à saisir dans Portainer (stack homelab.yml → Environment variables).
# Ce fichier ne contient que des exemples : aucune vraie valeur dans le dépôt.

# Mot de passe commun à toutes les applis (12 caractères au moins)
APPS_PASSWORD=change-moi-12-caracteres-minimum

# Dossier du NAS pour la base et ses sauvegardes
DOUZE_POINTS_DATA_DIR=/chemin/du/nas/douze-points

# Adresse de l'appli telle que les téléphones des invités la voient sur le Wi-Fi de la maison.
# Elle sert à fabriquer le QR code et le lien envoyé aux invités. Exemple (plage de documentation) :
DOUZE_POINTS_ADRESSE=http://192.0.2.10:8088

# Facultatif : adresse de Home Assistant appelée quand tous les classements sont envoyés.
# Vide : pas de notification, la régie seule l'affiche.
DOUZE_POINTS_HA_WEBHOOK=

# Facultatif
# PORT_DOUZE_POINTS=8088
